PORT=3000
DATABASE_PATH=./data/certificates.sqlite
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin@123$
JWT_SECRET=209ef9fae69dd0c2397925098e7f31f5dbbedd3ad8115d74819a126427c5761c
$loginBody = @{
  username = "admin"
  password = "admin@123$"
} | ConvertTo-Json

$login = Invoke-RestMethod -Method Post `
  -Uri "http://localhost:3000/api/admin/login" `
  -ContentType "application/json" `
  -Body $loginBody

$headers = @{ Authorization = "Bearer $($login.token)" }

$approval = Invoke-RestMethod -Method Patch `
  -Uri "http://localhost:3000/api/admin/applications/$($result.applicationId)/approve" `
  -Headers $headers

$approval